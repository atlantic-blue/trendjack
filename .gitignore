node_modules/
dist/
*.log

# The panel is the curation we do not publish. Only the invented sample fixture is committed.
panel.json
panel.*.json
!src/**/fixtures/**/panel*.json

# Anything that could carry a key or a real handle.
.env
.env.*
*.key
.secrets/

# Terraform working files.
.terraform/
.terraform.lock.hcl
*.tfstate
*.tfstate.*
digest.txt

# The web app is built, never committed.
apps/web/dist/

# Terraform state and lock files never go in.
infra/**/.terraform/
infra/**/.terraform.lock.hcl
infra/**/*.tfstate
infra/**/*.tfstate.*
