{
  "name": "trendjack",
  "version": "0.1.0",
  "description": "Find a short form video while it is still rising, adapt it to a product, and produce our version.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "author": "Julian Tellez",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/atlantic-blue/trendjack.git"
  },
  "engines": {
    "node": ">=22.6"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit && npm run typecheck --workspace @trendjack/web",
    "test": "npm run test --workspaces --if-present",
    "test:integration": "npm run test:integration --workspace @trendjack/core",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "npm run build --workspace @trendjack/web"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "prettier": "^3.4.0",
    "typescript": "^5.7.0"
  }
}
